OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
AXON_WAKE_WORD=hey axon

# Gemini Live is the only AXON voice engine in V14
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

# Optional workspace integrations
# Brave Search subscription token. AXON does not scrape search engines.
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# Used for image generation and image editing through the OpenAI Images API.
# OPENAI_API_KEY is also used by the OpenAI chat provider.
OPENAI_IMAGE_MODEL=gpt-image-2

# Local directory for generated images, PDF exports, screenshots, and photos.
AXON_OUTPUT_DIR=

# Google Workspace integrations
AXON_GOOGLE_CREDENTIALS=credentials.json
AXON_GOOGLE_TOKEN=~/.config/axon/google_token.json

# WhatsApp Business Platform / Cloud API
AXON_META_GRAPH_VERSION=v23.0
AXON_WHATSAPP_TOKEN=
AXON_WHATSAPP_PHONE_NUMBER_ID=
AXON_WHATSAPP_WABA_ID=

# Meta Messenger Platform (Facebook Page)
AXON_META_PAGE_ACCESS_TOKEN=
AXON_META_PAGE_ID=
AXON_META_APP_SECRET=
AXON_META_WEBHOOK_VERIFY_TOKEN=
AXON_WEBHOOK_HOST=127.0.0.1
AXON_WEBHOOK_PORT=8787
